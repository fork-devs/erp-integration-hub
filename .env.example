# ERP Integration Hub Environment Variables Template
SERVER_PORT=8085

# Security & Inter-service Communication
INTERNAL_SERVICE_KEY=erp_internal_secret_service_key_2026
JWKS_URL=http://localhost:8081/.well-known/jwks.json

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/erp_integration_db

# Rol de EJECUCION: sin privilegios de propietario y con NOBYPASSRLS, de
# modo que la politica de Row-Level Security le sea aplicable. El propietario
# de una tabla elude su propia politica, de modo que usar el mismo rol para
# la aplicacion y para las migraciones dejaba el aislamiento sin efecto.
ERP_APP_DB_USER=erp_app
ERP_APP_DB_PASSWORD=cambiar_en_cada_entorno

# Rol PROPIETARIO: lo usan unicamente las migraciones de Flyway, que
# necesitan permisos de DDL. Lo crea la migracion V3.
SPRING_FLYWAY_USER=integration_user
SPRING_FLYWAY_PASSWORD=cambiar_en_cada_entorno

# Rol de PLATAFORMA (BYPASSRLS): lo usa EXCLUSIVAMENTE el relay de
# reintentos, que recorre la cola de pendientes de todos los talleres porque
# todavia no conoce el taller de cada mensaje. No lo usa la aplicacion.
# Su credencial vive separada de la de la aplicacion para que un fallo de
# seguridad en la aplicacion no pueda escalarla.
ERP_PLATFORM_ROLE_USER=erp_platform
ERP_PLATFORM_ROLE_PASSWORD=cambiar_en_cada_entorno

# Redis Distributed Cache (RUC 30d / Placa 7d TTL)
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=

# External Provider: APISUNAT (SUNAT Facturación Electrónica v3)
APISUNAT_BASE_URL=https://sandbox.apisunat.pe
APISUNAT_TOKEN=sandbox_token_apisunat
APISUNAT_SANDBOX_MODE=true

# External Provider: Stripe (Credit/Debit Card Payments)
STRIPE_API_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_test_mock_secret
STRIPE_SANDBOX_MODE=true

# External Provider: Chequea.pe (SUNAT RUC Validations)
CHEQUEA_BASE_URL=https://api.chequea.pe/v1
CHEQUEA_TOKEN=sandbox_chequea_token
CHEQUEA_SANDBOX_MODE=true

# External Provider: API Perú (SUNARP Vehicle Plate)
APIPERU_BASE_URL=https://apiperu.dev/api
APIPERU_TOKEN=sandbox_apiperu_token
APIPERU_SANDBOX_MODE=true

# Resilience & Outbox Retry Queue
RETRY_ENABLED=true
RETRY_INTERVAL_MS=5000
